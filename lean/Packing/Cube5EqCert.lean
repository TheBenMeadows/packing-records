    (h7 : 0 ≤ -y1 + y3)
    (h8 : 0 ≤ -3/2 + y1 + y2 + y3)
    (h9 : 0 ≤ z1)
    (h10 : 0 ≤ 1 - z1)
    (h11 : 0 ≤ z2)
    (h12 : 0 ≤ 1 - z2)
    (h13 : 0 ≤ z3)
    (h14 : 0 ≤ 1 - z3)
    (h15 : 0 ≤ -z1 + z2)
    (h16 : 0 ≤ -z1 + z3)
    (h17 : 0 ≤ -3/2 + z1 + z2 + z3)
    (h18 : 0 ≤ y1 + y2 + y3 - z1 - z2 - z3)
    (h19 : 0 ≤ -z2 + z3)
    (hd : 5 / 4 ≤ (y1 - z1) ^ 2 + (y2 - z2) ^ 2 + (y3 - z3) ^ 2) :
    1 - y1 = 0 ∧ 1 - y2 = 0 ∧ 1 - y3 = 0 := by
  have hL : 3 - y1 - y2 - y3 ≤ 0 := by
    linarith [mul_nonneg h0 h7,
      mul_nonneg h0 h9,
      mul_nonneg h0 h14,
      mul_nonneg h1 h18,
      mul_nonneg h2 h3,
      mul_nonneg h2 h17,
      mul_nonneg h3 h5,
      mul_nonneg h3 h6,
      mul_nonneg h3 h12,
      mul_nonneg h3 h16,
      mul_nonneg h3 h19,
      mul_nonneg h5 h7,
      mul_nonneg h5 h8,
      mul_nonneg h5 h14,
      mul_nonneg h5 h15,
      mul_nonneg h6 h15,
      mul_nonneg h7 h16,
      mul_nonneg h8 h9,
      mul_nonneg h8 h17,
      mul_nonneg h9 h11,
      mul_nonneg h9 h15,
      mul_nonneg h12 h14,
      mul_nonneg h12 h17,
      mul_nonneg h13 h14,
      mul_nonneg h14 h19,
      mul_nonneg h17 h18,
      mul_nonneg h17 h19]
  exact ⟨by linarith, by linarith, by linarith⟩

