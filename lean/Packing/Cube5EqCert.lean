/-- A point `(u, v, w)` of the cube with `u ≥ v ≥ w`, `u + v + w ≤ 3/2` and squared norm at least `5/4` is `(1, 1/2, 0)`. -/
theorem hexagon_gap (u v w : ℝ)
    (h0 : 0 ≤ w)
    (h1 : 0 ≤ v - w)
    (h2 : 0 ≤ u - v)
    (h3 : 0 ≤ 1 - u)
    (h4 : 0 ≤ 3/2 - u - v - w)
    (hd : 5 / 4 ≤ u ^ 2 + v ^ 2 + w ^ 2) :
    w = 0 ∧ 1 - u = 0 ∧ 3/2 - u - v - w = 0 := by
  have hL : 5/2 - 2 * u - v ≤ 0 := by
    linarith [mul_nonneg h0 h1,
      mul_nonneg h0 h4,
      mul_nonneg h1 h4,
      mul_nonneg h2 h3]
  exact ⟨by linarith, by linarith, by linarith⟩

/-- Two points of the cube with least coordinate the first, coordinate sums at least `3/2`, the first point with the larger sum, at squared distance at least `5/4`: the first point is `(1, 1, 1)`. -/
theorem same_part_gap (y1 y2 y3 z1 z2 z3 : ℝ)
    (h0 : 0 ≤ y1)
    (h1 : 0 ≤ 1 - y1)
    (h2 : 0 ≤ y2)
    (h3 : 0 ≤ 1 - y2)
    (h4 : 0 ≤ y3)
    (h5 : 0 ≤ 1 - y3)
