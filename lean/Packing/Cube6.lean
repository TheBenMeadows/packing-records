theorem sqrt_two_sq : (3 * Real.sqrt 2 / 4) ^ 2 = 9 / 8 := by
  rw [div_pow, mul_pow, Real.sq_sqrt (by norm_num)]
  norm_num

/-- Any six points of the unit cube include two at distance at most `3 sqrt 2 / 4`. -/
theorem exists_dist_le_six (p : Fin 6 → Pt) (hp : ∀ i, InCube (p i)) :
    ∃ i j, i ≠ j ∧ dist (p i) (p j) ≤ 3 * Real.sqrt 2 / 4 := by
  obtain ⟨i, j, hij, hd⟩ := exists_dist_sq_le_six p hp
  exact ⟨i, j, hij, dist_le (by positivity) (by rw [sqrt_two_sq]; exact hd)⟩

/-- Schaer's configuration: the vertices of a regular octahedron, each at distance `1/4` from a
corner along an edge. -/
noncomputable def six : Fin 6 → Pt := fun i =>
  WithLp.toLp 2 (![![3 / 4, 0, 0], ![0, 3 / 4, 0], ![0, 0, 3 / 4], ![1 / 4, 1, 1], ![1, 1 / 4, 1],
    ![1, 1, 1 / 4]] i)

theorem six_apply (i : Fin 6) (c : Fin 3) :
    six i c = (![![3 / 4, 0, 0], ![0, 3 / 4, 0], ![0, 0, 3 / 4], ![1 / 4, 1, 1], ![1, 1 / 4, 1],
      ![1, 1, 1 / 4]] : Fin 6 → Fin 3 → ℝ) i c := rfl

theorem inCube_six (i : Fin 6) : InCube (six i) := by
  intro c
  rw [six_apply]
  fin_cases i <;> fin_cases c <;> norm_num

theorem dist_six {i j : Fin 6} (h : i ≠ j) : 3 * Real.sqrt 2 / 4 ≤ dist (six i) (six j) := by
  apply le_dist
  rw [sqrt_two_sq, dist_sq]
  simp only [six_apply]
  fin_cases i <;> fin_cases j <;> first | exact absurd rfl h | norm_num

/-- The largest minimum distance among six points of the unit cube is `3 sqrt 2 / 4`. -/
theorem isMaxMinDist_six : IsMaxMinDist 6 (3 * Real.sqrt 2 / 4) :=
  ⟨⟨six, inCube_six, fun _ _ h => dist_six h⟩, exists_dist_le_six⟩

/-- Six equal balls in the unit cube have radius at most `(9 - 6 sqrt 2) / 2`, and that radius
is attained. -/
theorem isMaxRadius_six : IsMaxRadius 6 ((9 - 6 * Real.sqrt 2) / 2) := by
  have h := maxRadius_of_maxMinDist (by positivity : (0 : ℝ) < 3 * Real.sqrt 2 / 4)
    isMaxMinDist_six
  have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have e : 3 * Real.sqrt 2 / 4 / (2 * (1 + 3 * Real.sqrt 2 / 4)) = (9 - 6 * Real.sqrt 2) / 2 := by
    rw [div_eq_iff (by positivity)]
    linear_combination (9 / 2) * h2
  rwa [e] at h

